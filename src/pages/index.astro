---
import BaseLayout from '../layouts/BaseLayout.astro';
import { SITE } from '../config.ts';
import { publishedArticles, typeLabel } from '../lib/articles.ts';

const articles = await publishedArticles();

function fmt(date: Date) {
  return date.toLocaleDateString('fr-FR', { year: 'numeric', month: 'long', day: 'numeric' });
}
---

<BaseLayout path="/">
  <section class="hero">
    <h1>Bien choisir et utiliser votre air fryer</h1>
    <p>{SITE.tagline}. Un nouveau guide, comparatif ou article publié chaque jour.</p>
  </section>

  <div class="container wide">
    {articles.length === 0 ? (
      <p style="text-align:center;color:var(--muted)">Les premiers articles arrivent très bientôt. Revenez demain !</p>
    ) : (
      <div class="grid">
        {articles.map((a) => (
          <a class="card" href={`/${a.id}`}>
            <span class="badge">{typeLabel(a.data.type)}</span>
            <h2>{a.data.title}</h2>
            <p>{a.data.description}</p>
            <time datetime={a.data.pubDate.toISOString()}>{fmt(a.data.pubDate)}</time>
          </a>
        ))}
      </div>
    )}
  </div>
</BaseLayout>
